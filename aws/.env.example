# Copy to aws/.env and fill in. aws/.env is git-ignored.
AWS_REGION=us-west-2
STACK_NAME=ignition-kafka
# An existing VPC, two private subnets in two AZs (with a NAT route), and a subnet for the Ignition host
VPC_ID=vpc-0123456789abcdef0
SUBNET_IDS=subnet-aaaa,subnet-bbbb
IGNITION_SUBNET_ID=subnet-aaaa

# Snowflake (same meaning as local/.env)
SNOWFLAKE_CONNECTION=default
SNOWFLAKE_ACCOUNT_URL=myorg-myaccount.snowflakecomputing.com
SNOWFLAKE_DATABASE=SNOWFLAKE_EXAMPLE
SNOWFLAKE_SCHEMA=IGNITION_KAFKA_DEMO
SNOWFLAKE_WAREHOUSE=SFE_IGNITION_KAFKA_DEMO_WH
SNOWFLAKE_ROLE=IGNITION_KAFKA_RL
SNOWFLAKE_USER=IGNITION_KAFKA_SVC
# NAT gateway public IP(s) of the VPC, as a CIDR; MSK Connect reaches Snowflake through it.
# scripts/aws_nat_ips.sh prints them.
SNOWFLAKE_ALLOWED_IP=203.0.113.20/32
