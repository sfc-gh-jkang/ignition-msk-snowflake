# Copy to local/.env and fill in. local/.env is git-ignored.

# Ignition gateway admin (web UI at http://localhost:8088)
IGNITION_ADMIN_PASSWORD=change-me-please

# SCRAM credentials Ignition uses to publish to Kafka
KAFKA_USERNAME=ignition
KAFKA_PASSWORD=change-me-too
KAFKA_TOPIC=scada.demo.line1

# Snowflake target. ACCOUNT_URL is <org>-<account>.snowflakecomputing.com (no https://)
SNOWFLAKE_CONNECTION=default
# Account identifier (org-account) used by the Ignition 8.1 REST mode to sign its JWT
SNOWFLAKE_ACCOUNT=MYORG-MYACCOUNT
SNOWFLAKE_ACCOUNT_URL=myorg-myaccount.snowflakecomputing.com
SNOWFLAKE_DATABASE=SNOWFLAKE_EXAMPLE
SNOWFLAKE_SCHEMA=IGNITION_KAFKA_DEMO
SNOWFLAKE_WAREHOUSE=SFE_IGNITION_KAFKA_DEMO_WH
SNOWFLAKE_ROLE=IGNITION_KAFKA_RL
SNOWFLAKE_USER=IGNITION_KAFKA_SVC
# Public egress IP (CIDR) of wherever Kafka Connect runs, for the service user's network policy
SNOWFLAKE_ALLOWED_IP=203.0.113.10/32
